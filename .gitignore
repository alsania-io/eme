# .gitignore — EME Project

# Node
node_modules/
package-lock.json

# Build output
dist/

# Environment & secrets
.env
.env.keys
.env.local
.env.*.local

# Logs
*.log
logs/
npm-debug.log*

# Database files
*.db
*.db-shm
*.db-wal

# Runtime data
storage/vectors.db*
storage/logs/
storage/api-keys.json
storage/snapshots/*
!storage/snapshots/snapshots.json

# IDE
.vscode/
.idea/

# OS generated
.DS_Store
Thumbs.db

# Swap files
*.swp
*.swo
*.swn
*.swm
*.swx
*.swz

# Test & coverage
coverage/
.nyc_output/

# ESLint cache
.eslintcache

# PID & seed
*.pid
*.seed

# Map files
*.js.map
*.ts.map
*.css.map

# MCP config (may contain paths)
mcp-config.json

# Deprecated folder stays tracked (per Alsania rules)
# .deprecated/ — intentionally NOT ignored

# Python artifacts
*.pyc
__pycache__/

# EME Environment Configuration
# Copy to .env and customize

# Embedding Configuration
EMBEDDING_MODEL=local                    # local, openai, cohere, huggingface
EMBEDDING_DIMENSION=384                  # Vector dimension

# Vector Store Configuration
VECTOR_STORE=postgres                    # sqlite, postgres, qdrant, lancedb, memory
VECTOR_STORE_PATH=./storage/vectors.db   # For sqlite
POSTGRES_CONNECTION=postgresql://user:password@localhost:5432/eme_vectors
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=eme_vectors

# Graph Store Configuration
GRAPH_STORE=jsonl                        # sqlite, jsonl, memory
GRAPH_STORE_PATH=./storage/graph.jsonl

# Snapshot Configuration
SNAPSHOT_STORE=filesystem                # filesystem, ipfs, drive, s3
SNAPSHOT_PATH=./storage/snapshots

# Memory Gate Configuration
MEMORY_GATE_ENABLED=true
MEMORY_GATE_THRESHOLD=0.3

# Security
ENCRYPTION_KEY=                          # Optional encryption key

# General Configuration
MAX_MEMORY_ENTRIES=10000
SIMILARITY_THRESHOLD=0.3
LOG_LEVEL=info                           # debug, info, warn, error

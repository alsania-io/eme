# EME Environment Configuration
# Copy to .env and customize

# Embedding Configuration
EMBEDDING_MODEL=local                            # local, openai, cohere, huggingface, openrouter
EMBEDDING_MODEL_PATH=                            # Model name/path (e.g. nvidia/llama-nemotron-embed-vl-1b-v2:free for openrouter)
EMBEDDING_DIMENSION=384                          # Vector dimension (must match model output)

# OpenRouter API (required if EMBEDDING_MODEL=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_REFERER=https://alsania-io.com
OPENROUTER_TITLE=Echo Memory Engine

# Fallback embedding (used when primary provider fails)
FALLBACK_EMBEDDING_MODEL=local                   # local, openai, cohere, huggingface, openrouter
FALLBACK_EMBEDDING_DIMENSION=384

# Vector Store Configuration
VECTOR_STORE=memory                              # sqlite, postgres, qdrant, lancedb, memory
VECTOR_STORE_PATH=./storage/vectors.db           # For sqlite
POSTGRES_CONNECTION=postgresql://user:password@localhost:5432/eme_vectors
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=alsania-mem
QDRANT_VECTOR_NAME=                              # Optional: named vector for multivector collections

# Graph Store Configuration
GRAPH_STORE=memory                               # sqlite, jsonl, memory
GRAPH_STORE_PATH=./storage/graph.jsonl

# Snapshot Configuration
SNAPSHOT_STORE=filesystem                        # filesystem, ipfs, drive, s3
SNAPSHOT_PATH=./storage/snapshots

# Memory Gate Configuration
MEMORY_GATE_ENABLED=true
MEMORY_GATE_THRESHOLD=0.3

# Security
ENCRYPTION_KEY=                                  # Optional encryption key

# General Configuration
MAX_MEMORY_ENTRIES=10000
SIMILARITY_THRESHOLD=0.3
LOG_LEVEL=info                                   # debug, info, warn, error

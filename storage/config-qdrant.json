{
  "//": "EME Configuration Example - Choose your storage backends",
  "//": "====================================================",

  "embeddingModel": "default",
  "embeddingDimension": 1536,

  "//": "Vector Store Options: sqlite, postgres, qdrant, lancedb, memory, faiss",
  "//vectorStore": "qdrant",
  "//qdrantUrl": "http://localhost:6333/",
  "qdrantCollection": "alsania-mem",
  "//vectorStore": "postgres",
  "postgresConnection": "postgresql://user:password@localhost:5432/eme_vectors",
  "vectorStore": "SQLite",
  "vectorStorePath": "/home/sigma/Desktop/echo-lab/eme/storage/vectors.db",

  "//": "Graph Store Options: sqlite, jsonl, memory",
  "graphStore": "jsonl",
  "graphStorePath": "./storage/graph.jsonl",

  "//": "Snapshot Store Options: filesystem, filebase, ipfs, drive, s3",
  "snapshotStore": "filesystem",
  "snapshotPath": "./storage/snapshots",
  "//snapshotStore": "ipfs",
  "//snapshotConfig": {
  "//ipfsGateway": "https://ipfs.io",
  "//pinataJWT": "your-jwt-token-here"},

  "//": "Memory Gate Configuration",
    "memoryGateEnabled": true,
    "memoryGateThreshold": 0.2,

  "//": "General Configuration",
  "maxMemoryEntries": 10000,
  "similarityThreshold": 0.3,
  "logLevel": "info"
}

{
  "//": "EME Configuration - Optimized for Sigma's Workflow",
  "//": "Created by Aegis - December 27, 2025",
  "//": "Performance-tuned for: Project updates, chat memory, decisions",

  "//": "======================================================",
  "//": "EMBEDDING MODEL CONFIGURATION",
  "//": "======================================================",
  "embeddingModel": "bge-small-en-v1.5",
  "embeddingDimension": 384,
  "embeddingBatchSize": 32,
  "//": "BGE-small is fast, accurate, and 384-dimensional",
  "//": "Alternative: 'instructor-xl' (768d, more accurate but slower)",

  "//": "======================================================",
  "//": "VECTOR STORE - Optimized for rapid project updates",
  "//": "======================================================",
  "vectorStore": "sqlite",
  "vectorStorePath": "./storage/sigma-vectors.db",
  "vectorIndex": "hnsw",
  "hnswParameters": {
    "M": 16,
    "efConstruction": 200,
    "efSearch": 100
  },
  "//": "SQLite with HNSW index: Fast, reliable, persistent",
  "//": "Perfect for frequent project status updates",

  "//": "======================================================",
  "//": "GRAPH STORE - Optimized for task/decision tracking",
  "//": "======================================================",
  "graphStore": "sqlite",
  "graphStorePath": "./storage/sigma-graph.db",
  "autoCreateGraphNodes": true,
  "graphNodeTypes": ["project", "task", "decision", "person", "meeting"],
  "graphEdgeTypes": ["depends_on", "assigned_to", "resulted_in", "related_to"],
  "//": "Auto-creates nodes for: Projects, tasks, decisions, people",
  "//": "Enables quick project status visualization",

  "//": "======================================================",
  "//": "SNAPSHOT SYSTEM - Optimized for daily workflow",
  "//": "======================================================",
  "snapshotStore": "filesystem",
  "snapshotPath": "./storage/snapshots",
  "snapshotFrequency": "daily",
  "snapshotRetention": 7,
  "snapshotCompression": true,
  "autoSnapshot": true,
  "//": "Daily automatic snapshots, keep last 7 days",
  "//": "Perfect for rolling back to previous project states",

  "//": "======================================================",
  "//": "MEMORY GATE - Tuned for Sigma's conversation patterns",
  "//": "======================================================",
  "memoryGateEnabled": true,
  "memoryGateThreshold": 0.25,
  "minMemoryLength": 15,
  "maxMemoriesPerNamespacePerDay": 500,
  "memoryGatePrototypes": [
    "aegis", "sigma", "echo", "alsania", "deepseek", "nyx",
    "project", "task", "decision", "meeting", "update", "status",
    "development", "testing", "deployment", "architecture", "fix",
    "memory", "engine", "vector", "graph", "snapshot", "chat",
    "command", "mission", "verification", "integration", "workflow"
  ],
  "//": "Lower threshold (0.25) for Sigma's technical conversations",
  "//": "Custom prototypes for our ecosystem terms",

  "//": "======================================================",
  "//": "NAMESPACE CONFIGURATION - Sigma's workflow structure",
  "//": "======================================================",
  "defaultNamespaces": {
    "project-status": {
      "description": "Hourly project updates and status tracking",
      "maxMemories": 1000,
      "autoCleanupDays": 30
    },
    "chat-memory": {
      "description": "End-of-chat session summaries",
      "maxMemories": 500,
      "autoCleanupDays": 14
    },
    "decisions": {
      "description": "Architecture and technical decisions",
      "maxMemories": 200,
      "autoCleanupDays": 90
    },
    "tasks": {
      "description": "Todo lists and progress tracking",
      "maxMemories": 1000,
      "autoCleanupDays": 7
    },
    "workflow": {
      "description": "Sigma's personal workflow patterns",
      "maxMemories": 1000,
      "autoCleanupDays": 30
    }
  },

  "//": "======================================================",
  "//": "PERFORMANCE TUNING - Optimized for responsiveness",
  "//": "======================================================",
  "maxMemoryEntries": 10000,
  "similarityThreshold": 0.3,
  "searchLimit": 10,
  "cacheEnabled": true,
  "cacheSize": 1000,
  "cacheTTL": 600000,
  "//": "10-minute cache for frequent searches",

  "//": "======================================================",
  "//": "LOGGING AND MONITORING",
  "//": "======================================================",
  "logLevel": "info",
  "logFile": "./storage/logs/eme-sigma.log",
  "logRotation": {
    "size": "10m",
    "keep": 10
  },
  "metricsEnabled": true,
  "metricsPort": 9091,
  "//": "Prometheus metrics available on port 9091",

  "//": "======================================================",
  "//": "INTEGRATION SETTINGS - MCP and external systems",
  "//": "======================================================",
  "mcpServerPort": 8048,
  "enableHttpTransport": true,
  "enableStdioTransport": true,
  "enableSSETransport": true,
  "httpCorsOrigin": "*",
  "//": "Multiple transport options for different MCP clients",

  "//": "======================================================",
  "//": "SECURITY AND PRIVACY",
  "//": "======================================================",
  "encryptionEnabled": false,
  "//encryptionKey": "generate-with: openssl rand -hex 32",
  "requireAuthentication": false,
  "//jwtSecret": "generate-secure-secret-here",
  "//": "Enable encryption for sensitive workflow data",

  "//": "======================================================",
  "//": "DEPLOYMENT READINESS",
  "//": "======================================================",
  "deploymentReady": true,
  "testedPatterns": [
    "project-status-updates",
    "chat-session-memory",
    "technical-decisions",
    "task-tracking",
    "batch-operations",
    "namespace-isolation"
  ],
  "performanceTargets": {
    "memoryAddTime": "<100ms",
    "searchTime": "<200ms",
    "batchTime": "<500ms (10 items)"
  }
}

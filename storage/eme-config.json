{
  "embeddingModel": "openrouter",
  "embeddingModelPath": "nvidia/llama-nemotron-embed-vl-1b-v2:free",
  "embeddingDimension": 2048,
  "openRouterApiKey": "${OPENROUTERAPIKEY}",
  "openRouterReferer": "https://alsania-io.com",
  "openRouterTitle": "Echo Memory Engine",
  "fallbackEmbeddingModel": "local",
  "fallbackEmbeddingDimension": 384,
  "vectorStore": "qdrant",
  "vectorStorePath": "./storage/vectors.db",
  "qdrantUrl": "http://localhost:6333",
  "qdrantCollection": "am2",
  "qdrantVectorName": "v2048",
  "graphStore": "memory",
  "graphStorePath": "./storage/graph.db",
  "snapshotStore": "filesystem",
  "snapshotPath": "./storage/snapshots",
  "memoryGateEnabled": true,
  "memoryGateThreshold": 0.3,
  "maxMemoryEntries": 10000,
  "similarityThreshold": 0.3,
  "logLevel": "info",
  "development": true,
  "storageRouter": {
    "rcloneConfigPath": "./storage/rclone.conf",
    "destinations": [
      { "id": "filebase-pin", "kind": "ipfs", "role": "immutable", "health": { "ok": false }, "config": { "note": "Filebase IPFS pinning via ipfs-store (O5: not merged with filebase-s3)" } },
      { "id": "filebase-s3", "kind": "rclone", "role": "archive", "remote": "filebase-s3:", "health": { "ok": false }, "config": { "note": "S3-compatible archive; remote not provisioned" } },
      { "id": "mega-pool", "kind": "rclone", "role": "archive", "remotes": ["mega1:", "mega2:", "mega3:", "mega4:", "mega5:"], "poolStrategy": "round-robin", "health": { "ok": false }, "config": { "note": "5-account MEGA pool; remotes not provisioned" } },
      { "id": "qdrant", "kind": "qdrant", "role": "vector", "url": "http://localhost:6333", "health": { "ok": true }, "config": { "collection": "am2" } },
      { "id": "ext-hd", "kind": "local", "role": "mirror", "path": "/mnt/ext-hd/eme", "health": { "ok": false }, "config": {} },
      { "id": "secret", "kind": "rclone", "role": "secret", "remote": "secret-crypt:", "health": { "ok": false }, "config": { "note": "rclone crypt remote for secrets (Phase 3)" } },
      { "id": "in-process", "kind": "local", "role": "vector", "path": ":memory:", "health": { "ok": true }, "config": { "note": "hot/warm tiers live in-process" } }
    ],
    "rules": [
      { "id": "immutable", "match": { "dataClass": "immutable" }, "primary": "filebase-pin", "secondary": ["mega-pool"], "verify": "hash", "encrypt": false },
      { "id": "archive", "match": { "dataClass": "archive" }, "primary": "mega-pool", "verify": "hash", "encrypt": false },
      { "id": "vector", "match": { "dataClass": "vector" }, "primary": "qdrant", "verify": "none", "encrypt": false },
      { "id": "secret", "match": { "dataClass": "secret" }, "primary": "secret", "verify": "hash", "encrypt": true },
      { "id": "mirror", "match": { "dataClass": "mirror" }, "primary": "ext-hd", "secondary": ["mega-pool"], "verify": "hash", "encrypt": false },
      { "id": "tier-hot", "match": { "tier": "hot" }, "primary": "in-process", "verify": "none", "encrypt": false },
      { "id": "tier-warm", "match": { "tier": "warm" }, "primary": "in-process", "verify": "none", "encrypt": false },
      { "id": "tier-cold", "match": { "tier": "cold" }, "primary": "qdrant", "verify": "none", "encrypt": false }
    ]
  }
}
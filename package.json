{
  "name": "@alsania-io/eme",
  "version": "1.1.4",
  "description": "Echo Memory Engine - Alsania's sovereign memory system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alsania-dev/eme.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "format": "prettier --write src/**/*.ts",
    "clean": "rimraf dist",
    "postinstall": "node -e \"if (fs.existsSync('src')) { try { require('child_process').execSync('npm run format', { stdio: 'inherit' }) } catch(e) {} }\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "sed -i '1{/^#!\\/usr\\/bin\\/env node/d}' dist/index.js && sed -i '1s|^|#!/usr/bin/env node\\n|' dist/index.js && chmod +x dist/index.js",
    "verify:bin": "head -n 1 dist/index.js | grep -q node || (echo 'Missing shebang!' && exit 1)",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspector": "npx -y @modelcontextprotocol/inspector",
    "start:clean": "node --no-warnings dist/index.js server",
    "server": "node dist/index.js server",
    "test:cli": "node dist/index.js test",
    "config": "node dist/index.js config",
    "help": "node dist/index.js help",
    "test": "jest",
    "test:verbose": "jest --verbose",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepublishOnly": "npm run build && chmod +x dist/index.js",
    "build:mcpb": "node scripts/build-mcpb.cjs",
    "release:patch": "npm version patch && npm publish --access public",
    "release:minor": "npm version minor && npm publish --access public"
  },
  "keywords": [
    "memory",
    "mcp",
    "alsania",
    "vector",
    "graph",
    "ai",
    "agent"
  ],
  "author": "Alsania I/O",
  "license": "MIT",
  "bin": {
    "eme": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@dbml/core": "^6.3.0",
    "@exodus/bytes": "^1.14.1",
    "@helia/dag-cbor": "^5.0.7",
    "@helia/ipns": "^9.1.9",
    "@helia/unixfs": "^7.0.4",
    "@libp2p/interface": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "helia": "^6.0.20",
    "lru-cache": "^11.2.6",
    "openai": "^6.27.0",
    "p-limit": "^7.3.0",
    "p-queue": "^9.1.0",
    "rimraf": "^6.1.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
